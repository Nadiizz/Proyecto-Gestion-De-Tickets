# ============================================
# Configuración de Email (SMTP)
# ============================================
# Usar Gmail: smtp.gmail.com
# Para Gmail usar contraseña de aplicación (no contraseña normal)

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_contraseña_aplicacion
DEFAULT_FROM_EMAIL=noreply@coyahue.com

# ============================================
# Configuración de Twilio (WhatsApp)
# ============================================
# Obtener credentials en https://www.twilio.com/console

TWILIO_ACCOUNT_SID=tu_account_sid_aqui
TWILIO_AUTH_TOKEN=tu_auth_token_aqui
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# ============================================
# Otras Configuraciones (Django)
# ============================================

SECRET_KEY=tu_secret_key_django
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,tu_dominio.com

